#!/usr/bin/env zsh

# Move windows by using ctl + cmd + mouse
defaults write NSGlobalDomain NSWindowShouldDragOnGesture -bool true

# Expand save panel by default
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true

# Expand print panel by default
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true

# Set keyboard repeat rate
defaults write NSGlobalDomain KeyRepeat -int 2
defaults write NSGlobalDomain InitialKeyRepeat -int 15

# Disable press-and-hold for keys in favor of key repeat
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false

# Set language and text formats
defaults write NSGlobalDomain AppleLanguages -array "en-US" "nl-NL"
defaults write NSGlobalDomain AppleLocale -string "en_NL"
defaults write NSGlobalDomain AppleMeasurementUnits -string "Centimeters"
defaults write NSGlobalDomain AppleMetricUnits -bool true

# Enable full keyboard access for all controls
# (e.g. enable Tab in modal dialogs)
defaults write NSGlobalDomain AppleKeyboardUIMode -int 3

# Use F1, F2, etc. as standard function keys
defaults write NSGlobalDomain com.apple.keyboard.fnState -bool true

# Pressing fn key will do nothing
defaults write com.apple.HIToolbox AppleFnUsageType -int 0

# Save screenshots to the desktop
defaults write com.apple.screencapture location -string "${HOME}/Desktop"

# Remove margins in window tiling
defaults write com.apple.WindowManager EnableTiledWindowMargins -bool false

# Rebind window tiling shortcuts off the awkward control + globe defaults.
# Parameters are (ascii, key code, modifier mask); 65535 means the key has no
# ascii equivalent. Masks: shift 131072, control 262144, option 524288,
# command 1048576, fn 8388608.
hotkey() {
  defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add "$1" "<dict><key>enabled</key><true/><key>value</key><dict><key>parameters</key><array><integer>$2</integer><integer>$3</integer><integer>$4</integer></array><key>type</key><string>standard</string></dict></dict>"
}
hotkey 237 102 3 786432       # Fill:                    ctrl + opt + F
hotkey 238 99 8 786432        # Center:                  ctrl + opt + C
hotkey 239 114 15 786432      # Return to Previous Size: ctrl + opt + R
hotkey 240 65535 123 9175040  # Tile Left Half:          ctrl + opt + left
hotkey 241 65535 124 9175040  # Tile Right Half:         ctrl + opt + right
hotkey 242 65535 126 9175040  # Tile Top Half:           ctrl + opt + up
hotkey 243 65535 125 9175040  # Tile Bottom Half:        ctrl + opt + down
hotkey 248 65535 123 9306112  # Arrange Left & Right:    ctrl + opt + shift + left
hotkey 249 65535 124 9306112  # Arrange Right & Left:    ctrl + opt + shift + right
hotkey 250 65535 126 9306112  # Arrange Top & Bottom:    ctrl + opt + shift + up
hotkey 251 65535 125 9306112  # Arrange Bottom & Top:    ctrl + opt + shift + down

# Disable crash reporter dialog
defaults write com.apple.CrashReporter DialogType none

# Finder: show hidden files by default (⌘ + ⇧ + . to toggle)
defaults write com.apple.finder AppleShowAllFiles -bool true

# Finder: show all filename extensions
defaults write NSGlobalDomain AppleShowAllExtensions -bool true

# Finder: disable file extension changes warning
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false

# Finder: show path bar
defaults write com.apple.finder ShowPathbar -bool true

# Finder: use list view in all Finder windows by default
# Four-letter codes for the other view modes: `icnv`, `clmv`, `glyv`
defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"

# Finder: disable the warning when emptying the Trash
defaults write com.apple.finder WarnOnEmptyTrash -bool false

# Dock: configure auto hide
defaults write com.apple.dock autohide -bool true

# Dock: set the icon size to 48 pixels
defaults write com.apple.dock tilesize -int 48

# Dock: don’t show recent applications
defaults write com.apple.dock show-recents -bool false

# Dock: remove all applications
defaults write com.apple.dock persistent-apps -array

# TextEdit: start in plain text mode
defaults write com.apple.TextEdit RichText -int 0

# Simulator: show clicks
defaults write com.apple.iphonesimulator ShowSingleTouches -bool true
